# Scalable Brain — System 1 (The Brain) environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never
# be committed; neither may anything under `secrets/`.
#
#   cp .env.example .env
#   python -c "from src.common.db import get_engine; get_engine().connect(); print('DB OK')"

# --- Database -----------------------------------------------------------------
# PostgreSQL 16 + TimescaleDB, host cluster. Connect only via src/common/db.py —
# never build a connection string inline.
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=ForexBrainDB
DB_USER=sa
# Avoid shell-special characters ($ ` " \) — they have caused quoting bugs in
# cron scripts and psql URLs.
DB_PASS=change-me

# --- OANDA (price ingest only; System 1 never places orders) -------------------
OANDA_API_KEY=change-me
OANDA_ACCOUNT_ID=101-002-00000000-000
OANDA_ENV=practice
OANDA_URL=https://api-fxpractice.oanda.com

# --- Artifact storage ---------------------------------------------------------
# gcs | localfs. The backend copy of latest.json is authoritative — the local
# model-artifacts/latest.json may lag it.
STORAGE_PROVIDER=gcs
GCS_BUCKET=scalable-brain-artifacts
STORAGE_LOCAL_ROOT=model-artifacts
# Path to the service-account key. Lives in secrets/ (git-ignored).
GOOGLE_APPLICATION_CREDENTIALS=secrets/system1-rw.json

# --- Queue --------------------------------------------------------------------
# local | pubsub. While this is `local`, scored signals land in
# results/state/queue/ on this machine and System 3 cannot read them.
QUEUE_PROVIDER=local
QUEUE_LOCAL_ROOT=results/state/queue
# TOPIC NAMES ARE CASE-SENSITIVE and are passed to topic_path() verbatim. These were
# TitleCase here (Scored_Signal_Queue) while every provisioned topic is lowercase with
# underscores — copying this file produced a config that publishes into topics that do
# not exist and 404s on every send. Keep in sync with shell/provision_pubsub.sh.
SCORED_SIGNAL_QUEUE=scored_signal_queue
DLQ_NAME=scored_signal_dlq
# Liveness pings, on their own topic so a heartbeat can never be mistaken for a signal.
SIGNAL_HEARTBEAT_TOPIC=scored_signal_heartbeat
MAX_QUEUE_SIZE=10000
BACKPRESSURE_TIMEOUT_MS=5000
BACKPRESSURE_MAX_RETRIES=3
# Provenance stamping (producer / bundle_id / drill) is ON by default IN CODE, not here —
# this file is a template and .env is git-ignored, so a default that lives only in a
# variable is a promise that exists on one host. Systems 2 and 3 read an absent `drill`
# as a REAL order and rely on it being stamped on every message. Set this to `false`
# only to stop stamping deliberately, and tell them when you do.
# EMIT_PROVENANCE_FIELDS=false

# --- Legacy -------------------------------------------------------------------
# Layer-3 approval threshold; retained for the legacy tournament trainer only.
LAYER3_APPROVAL_THRESHOLD=0.20
