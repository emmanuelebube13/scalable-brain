{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scored_Signal_Queue message contract v2",
  "description": "Versioned message published by System 1/System 2 and consumed by System 3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "signal_id",
    "pair",
    "granularity",
    "signal_time_utc",
    "direction",
    "proposed_entry",
    "proposed_sl",
    "proposed_tp",
    "atr",
    "model_score",
    "approved",
    "threshold_applied",
    "regime",
    "regime_probs",
    "producer",
    "model_set_id",
    "reference_vector_ok",
    "produced_at_utc",
    "strategy_id",
    "scoring_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "signal_id": {
      "type": "string",
      "minLength": 1
    },
    "pair": {
      "type": "string"
    },
    "granularity": {
      "type": "string",
      "enum": [
        "H1",
        "H4",
        "D1",
        "W1"
      ]
    },
    "signal_time_utc": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "long",
        "short"
      ]
    },
    "proposed_entry": {
      "type": "number"
    },
    "proposed_sl": {
      "type": "number"
    },
    "proposed_tp": {
      "type": "number"
    },
    "atr": {
      "type": "number",
      "description": "ATR(14) computed on the primary granularity by the producer."
    },
    "model_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "approved": {
      "type": "boolean"
    },
    "threshold_applied": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "regime": {
      "type": "string",
      "enum": [
        "Trending-Up",
        "Trending-Down",
        "Ranging",
        "High-Vol"
      ]
    },
    "regime_probs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trending_up",
        "trending_down",
        "ranging",
        "high_vol"
      ],
      "properties": {
        "trending_up": {
          "type": "number"
        },
        "trending_down": {
          "type": "number"
        },
        "ranging": {
          "type": "number"
        },
        "high_vol": {
          "type": "number"
        }
      }
    },
    "producer": {
      "type": "string",
      "enum": ["system1", "system2"],
      "description": "Which system produced the signal."
    },
    "model_set_id": {
      "type": "string",
      "description": "Replaces bundle_version. The exact model set identifier the producer used."
    },
    "reference_vector_ok": {
      "type": "boolean",
      "description": "Whether System 2 confirmed determinism against the reference vector at startup."
    },
    "produced_at_utc": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable integer id, sent AS A STRING."
    },
    "strategy_key": {
      "type": "string",
      "minLength": 1
    },
    "selection_basis": {
      "type": "string",
      "enum": [
        "qualified",
        "designated"
      ],
      "description": "Optional (not required). System 3 sizes on this."
    },
    "scoring_status": {
      "type": "string",
      "enum": [
        "scored",
        "unscored"
      ]
    }
  }
}
